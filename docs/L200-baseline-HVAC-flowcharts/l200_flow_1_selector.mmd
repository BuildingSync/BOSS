flowchart TD
  IN(["HVACSystems XML"]) --> SYS{"Each HVACSystem: has Delivery<br/>or OtherHVACSystem records?"}
  SYS -- "no (only Principal/PrimaryHVACSystemType)" --> MISS
  SYS -- yes --> DUP{"IDs unique?"}
  DUP -- no --> R_CONF["conflicting_input"]
  DUP -- yes --> SPLIT["Deliveries owned by a ventilation record<br/>are judged with that record, not as conditioning"]
  SPLIT --> SEL["Each remaining Delivery: follow HeatingSourceID / CoolingSourceID<br/>→ sources → Heating / Cooling / Condenser plants"]
  SEL --> REFOK{"References resolve; source IDs<br/>and premises present?"}
  REFOK -- "broken / conflicting" --> R_CONF
  REFOK -- "field missing" --> MISS
  REFOK -- yes --> RULES{"DELIVERY_RULES + NOT_MAPPABLE_DELIVERY"}
  RULES -- "one supported rule" --> GUARD{"Must-be-absent elements absent<br/>and guards pass?"}
  GUARD -- no --> R_CONF
  GUARD -- yes --> MATCH["match:<br/>PTAC→hvac_ptac · PTHP→hvac_pthp<br/>RTU AC→hvac_packaged_rooftop_ac<br/>RTU HP→hvac_packaged_rooftop_heat_pump<br/>(supplemental_heating_fuel from HeatPumpBackupSystemFuel)<br/>Pkg VAV HW reheat · VAV HW reheat<br/>Warm air furnace · VRF · 4-pipe FCU"]
  RULES -- "gap rule" --> GAP["mapping_gap:<br/>VAV electric reheat, WLHP, GSHP,<br/>chilled beam, radiant"]
  RULES -- "one not-mappable hit" --> NM["not_mappable:<br/>split DX, split/mini/multi-split HP, SPVAC/SPVHP,<br/>field-assembled DX, 2-pipe fan coil, baseboard/radiator,<br/>heating-only or cooling-only pair, multizone CAV / CAV reheat,<br/>VAV no reheat, unsupported VAV reheat, UFAD, evaporative,<br/>steam/district/solar heat, absorption/district cooling,<br/>air-cooled chiller"]
  RULES -- "more than one hit" --> R_CONF
  RULES -- "no hit" --> MISS["missing_input"]
  SPLIT --> OTH["Each OtherHVACSystem"]
  OTH --> EQ{"Spot exhaust, humidifier, dehumidifier,<br/>air cleaner, natural ventilation?"}
  EQ -- yes --> NM
  EQ -- no --> VENT{"VentilationType"}
  VENT -- "missing" --> MISS
  VENT -- "more than one" --> R_CONF
  VENT -- "HRV / ERV / Exhaust only" --> NM
  VENT -- "integrated with air distribution" --> INTEG["integrated<br/>(linked deliveries judged as conditioning)"]
  VENT -- "None" --> ANNOT["no_hvac<br/>(explicitly no HVAC, or no separate<br/>ventilation equipment)"]
  VENT -- "Supply only / DOAS" --> VCHK{"Links resolve and not shared?<br/>Deliveries unconditioned?<br/>Stand-alone, single-duct CAV?<br/>Guards pass?"}
  VCHK -- "broken / shared link, guard fails" --> R_CONF
  VCHK -- "deliveries heated or cooled" --> NM
  VCHK -- "requirements not met" --> MISS
  VCHK -- yes --> VMATCH["match: Supply only → hvac_ventilation_only<br/>DOAS → hvac_doas"]
  MATCH --> PREM["Attach premises: own LinkedPremises,<br/>else inherit HVACSystem's"]
  VMATCH --> PREM
  PREM --> OUT(["Results → Planner"])
  R_CONF --> OUT
  GAP --> OUT
  NM --> OUT
  MISS --> OUT
  INTEG --> OUT
  ANNOT --> OUT
